# Copy to ~/getmap/getmap.env (setup.sh does this) and fill in.

# Postgres on this Mac (setup.sh creates the database and the role)
DATABASE_URL=postgresql://getmap@localhost:5432/getmap

# openssl rand -hex 32. The route servers (GETMAP_KEY) and GET.ride's Supabase
# secrets use the same value.
CAPTURE_API_KEY=

PORT=8090

# The data viewer: http://<mac-mini-ip>:8090/ui  (sign in with these)
UI_USER=admin
UI_PASSWORD=
UI_TIMEZONE=Asia/Kuala_Lumpur
# The background map in the viewer is only shown in your browser, never stored.
# Empty = no background. Or use your NAS map tiles.
UI_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
WORKERS=4
SPOOL_DIR=/Users/Shared/getmap/spool

# ---- storage (512 GB disk) -----------------------------------------------------------
# The disk Postgres keeps its data on, and the guard's limits. macOS and apps
# take ~60 GB, and an SSD should keep ~15% free: 300 GB for the database
# leaves room for macOS updates, WAL and the nightly backup's temp files.
DISK_PATH=/
MAX_DB_GB=300
MIN_FREE_DISK_GB=80

RETAIN_RAW_DAYS=7
RETAIN_EVENTS_DAYS=400
RETAIN_TRAFFIC_DAYS=800
RETAIN_SHAPES_DAYS=180
RETAIN_ALERTS_DAYS=800
RETAIN_WEATHER_DAYS=800
STORE_RAW=sample
RAW_SAMPLE_RATE=0.01
SHAPE_TOLERANCE_M=10

# ---- enrichment ----------------------------------------------------------------------
ENRICH_OSM=1
ENRICH_WEATHER=1
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# ---- the transparent tap (optional): the route servers on the NAS ------------------------
# UPSTREAM_GET_ROUTE=http://NAS_IP:8000
# UPSTREAM_GET_ROUTE_BACKUP=http://NAS_IP:8081
# UPSTREAM_GET_ROUTE_APPLE=http://NAS_IP:8085

# ---- backups (backup.sh) -------------------------------------------------------------
# A folder on the NAS, mounted on this Mac (Finder › Go › Connect to Server, then
# add it to Login Items so it mounts again after a restart).
BACKUP_DIR=/Volumes/backup/getmap
BACKUP_KEEP=7
