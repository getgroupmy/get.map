# GET.route's Docker network (sudo docker inspect get-route-tunnel ...)
GET_ROUTE_NETWORK=nas_default

# Supabase: Project Settings › Database › Connection string › Session pooler.
# Use a dedicated role that can only write the map schema.
DATABASE_URL=postgresql://getmap_writer.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# openssl rand -hex 32 — also set as GETMAP_KEY in the route servers and in Supabase secrets
CAPTURE_API_KEY=

# Optional: the transparent tap (GET /tap/<source>/...)
UPSTREAM_GET_ROUTE=http://get-route-pool:8000
UPSTREAM_GET_ROUTE_BACKUP=http://traffic-scraper:8000
UPSTREAM_GET_ROUTE_APPLE=http://get-route-apple:8000

# Enrichment (on by default). Point OVERPASS_URL at your own Overpass for volume.
ENRICH_OSM=1
ENRICH_WEATHER=1
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# CAMERA_DIRECTION_MEANS=travel
